# Cartório Gestão — variáveis de ambiente (EXEMPLO).
# Copie para `.env` só se o seu modo de instalação ler .env; o `.env` real
# NUNCA vai para o Git. Valores abaixo são vazios/padrão de propósito.

# --- Mínimo (ambiente.py / app.get_data_dir) ---
CARTORIO_GESTAO_DATA=          # pasta de dados (banco, arquivos, backups); vazio = %PROGRAMDATA%\CartorioGestao
CARTORIO_GESTAO_SANDBOX=       # 1 = isolamento sandbox (centrais/IA vão para os simulados)
CARTORIO_GESTAO_NO_BROWSER=0   # 1 = modo serviço, não abre o navegador
# PROGRAMDATA=                 # normalmente já vem do SO; base de *.cred e secret.key

# --- Opcionais já lidos no código ---
MALOTE_DATA_DIR=
NU_AVISOS_MODAL_SEMPRE=0
# CARTORIO_DATA_DIR=           # só scripts temporários; não é variável do produto

# --- WhatsApp Balcão (se o módulo estiver no build) — nunca commitar .env ---
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_CAIXA_SEGREDO=
WA_CAIXA_DIR=

# --- Flask secret ---
# Arquivo local: %PROGRAMDATA%\CartorioGestao\secret.key (app.py / new_secret_key).
# Não versionar. Não usar SECRET_KEY no .env.

# --- Credenciais das centrais NÃO ficam aqui ---
# Use /configuracoes § Centrais → %PROGRAMDATA%\CartorioGestao\*.cred
# (cra, cenprot, onrtdpj, onrcpn, onr, resolve, sirc, cnib, selador)
# CRC: certificado A3 + PIN sob demanda (sem arquivo .cred).

# --- Dados da serventia NÃO ficam aqui ---
# Nome, CNS, CNPJ, endereço, titular, brasão e host do selador moram na tabela
# `settings` (Configurações → Serventia). Instalação antiga: rode uma vez
# tools/migrar_settings_serventia_b0.py (faz backup antes).

# --- CI anti-vazamento (só no GitHub Actions; cadastrado pelo oficial) ---
# CG_DENYLIST_LOCAL=           # secret do repositório = conteúdo de ci/denylist.local.txt

# Ignorar no exemplo (só wrappers .cmd de instalação): PY, PS, RC, ELEV_RC, CODIGO, ROOT, RESPOSTA
