# O SERVIDOR DO CARTÓRIO GESTÃO NO LINUX — a configuração (docs/SERVIDOR_LINUX.md).
# O instalar_servidor.sh grava este arquivo em /etc/cartorio-gestao/servidor.env, e é LÁ que se
# edita (depois: systemctl restart cartorio-gestao). Formato do systemd: CHAVE=valor, sem aspas
# nem $VARIAVEL. Nenhuma senha aqui: a do banco fica no .pgpass da pasta de dados.

# A pasta de dados: documentos, backups, chaves e os *.cred das Centrais.
CARTORIO_GESTAO_DATA=@DADOS@

# O banco: PostgreSQL local, só em localhost, SEM senha na linha (ela vem do PGPASSFILE).
CG_PG_DSN=host=127.0.0.1 port=@PORTA@ user=cg dbname=cartorio
CG_PG_SCHEMA=producao
PGPASSFILE=@DADOS@/.pgpass
# O pg_dump/pg_restore do backup e da restauração.
CG_PG_BIN=@PG_BIN@

# O serviço não abre navegador.
CARTORIO_GESTAO_NO_BROWSER=1
