# O SERVIDOR RESERVA NO macOS — a configuração (docs/SERVIDOR_RESERVA_MACOS.md).
# O instalar_reserva.sh copia este arquivo para
#   ~/Library/Application Support/CartorioGestao/reserva.env
# e é LÁ que se edita. Nenhuma senha aqui: as senhas ficam no ~/.pgpass (chmod 600).

# 1 = reserva (só lê). O assumir.sh troca para 0.
CG_MODO_RESERVA=1

# O sistema entra no banco da reserva com o usuário que SÓ LÊ (cg_leitor). O assumir.sh troca para cg.
CG_PG_DSN="host=127.0.0.1 port=5434 user=cg_leitor dbname=cartorio"
CG_PG_SCHEMA=producao

# A porta da reserva: diferente da do principal (8765).
CG_RESERVA_PORTA=8775
CG_RESERVA_HOST=0.0.0.0

# A pasta de dados do sistema neste Mac e a cópia da pasta de arquivos do principal.
CARTORIO_GESTAO_DATA="$HOME/Library/Application Support/CartorioGestao"
CG_RESERVA_ARQUIVOS="$HOME/Library/Application Support/CartorioGestao/arquivos"

# A réplica (tools/reserva.py): o principal pelo usuário cg_replica, e a reserva pelo dono.
CG_RESERVA_PRINCIPAL_DSN="host=IP_DO_SERVIDOR_WINDOWS port=5434 user=cg_replica dbname=cartorio sslmode=require"
CG_RESERVA_LOCAL_DSN="host=127.0.0.1 port=5434 user=cg dbname=cartorio"
CG_PG_BIN=/opt/homebrew/opt/postgresql@18/bin

# O nome dos serviços do launchd (o assumir.sh reinicia o <prefixo>.servidor).
CG_LAUNCHD_PREFIXO=br.com.cartoriogestao

# A pasta de arquivos do principal, compartilhada na rede do Windows (só leitura basta).
# Vazio = não copia arquivos. Ex.: //cartorio@IP_DO_SERVIDOR_WINDOWS/arquivos
CG_RESERVA_SMB=""
