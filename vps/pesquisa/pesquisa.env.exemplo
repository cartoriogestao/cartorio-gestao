# /etc/cartorio-pesquisa/pesquisa.env — configuração da pesquisa na VPS.
# Sem segredo aqui: o token mora em PESQUISA_TOKEN_ARQUIVO, com permissão 600.
PESQUISA_BANCO=/var/lib/cartorio-pesquisa/pesquisa.sqlite3
PESQUISA_TOKEN_ARQUIVO=/etc/cartorio-pesquisa/token
PESQUISA_ENDERECO=127.0.0.1
PESQUISA_PORTA=8782
PESQUISA_PREFIXO=/pesquisa
# 1 = só atende o que o Apache marcou como HTTPS (X-Forwarded-Proto). Não mude.
PESQUISA_EXIGIR_HTTPS=1
# O nome da serventia que aparece no alto da página.
PESQUISA_SERVENTIA=
