# /etc/cartorio-portal/portal.env — configuração do portal na VPS.
# Sem segredo aqui: o token mora em PORTAL_TOKEN_ARQUIVO, com permissão 600.
PORTAL_BANCO=/var/lib/cartorio-portal/portal.sqlite3
PORTAL_TOKEN_ARQUIVO=/etc/cartorio-portal/token
PORTAL_ENDERECO=127.0.0.1
PORTAL_PORTA=8781
PORTAL_PREFIXO=/portal
# 1 = só atende o que o Apache marcou como HTTPS (X-Forwarded-Proto). Não mude.
PORTAL_EXIGIR_HTTPS=1
# O nome da serventia e o contato que aparecem na página e no comprovante de
# acompanhamento em PDF (texto livre: telefone e e-mail do balcão, horário).
PORTAL_SERVENTIA=
PORTAL_CONTATO=
